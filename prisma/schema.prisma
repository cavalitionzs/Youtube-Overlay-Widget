// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model YoutubeCredentials {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  YOUTUBE_API_KEY  String @db.VarChar(500)
  YOUTUBE_VIDEO_ID String @db.VarChar(500)
}

model YoutubeChatState {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  liveChatId        String?   @db.VarChar(200)
  nextPageToken     String?   @db.VarChar(1000)
  lastPolledAt      DateTime?
  pollingIntervalMs Int?
}

model QueueItem {
  id          Int      @id @default(autoincrement())
  videoId     String   @db.VarChar(50)
  title       String   @db.VarChar(500)
  requestedBy String   @db.VarChar(200)
  requestedAt DateTime @default(now())
}

// Cache of "!request <judul lagu>" searches. Every row also doubles as a
// record that one search.list call (100 quota units) was made, which is
// how the daily search budget is counted. An empty videoId means "searched,
// found nothing" (negative cache).
model SearchCache {
  id        Int      @id @default(autoincrement())
  query     String   @unique @db.VarChar(300)
  videoId   String   @db.VarChar(50)
  title     String   @db.VarChar(500)
  createdAt DateTime @default(now())
}
